{
  "name": "ruanglabmu",
  "private": true,
  "version": "2.1.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build:client": "vite build",
    "build:server": "esbuild server.ts --bundle --platform=node --target=node22 --outfile=dist-server/server.cjs --external:express --external:ws",
    "build": "npm run build:client && npm run build:server",
    "start": "node -e \"process.env.NODE_ENV='production'; require('./dist-server/server.cjs')\"",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-server",
    "lint": "tsc --noEmit",
    "test": "tsx --test src/utils/*.test.ts src/utils/engines/*.test.ts server/utils/*.test.ts"
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "@types/qrcode": "^1.5.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "i18next": "^27.1.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-i18next": "^18.0.1",
    "three": "^0.187.0",
    "ws": "^8.22.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^2.0.0"
  }
}
